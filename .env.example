BOT_TOKEN=
BOT_USERNAME=CubbieGroupieBot
MINI_APP_SHORT_NAME=app
PUBLIC_URL=              # https URL of the Railway deployment or local tunnel
WEBHOOK_SECRET=          # generate a random string
GROQ_API_KEY=
DATABASE_PATH=./data/groupie.db
LINK_SIGNING_SECRET=     # generate a random string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DEFAULT_TZ=America/Phoenix
DEV_MODE=true            # enables /seed, /reset, and /dev/* routes
PORT=3000
BOT_MODE=                # webhook (default in production) | polling (local testing, takes the bot from prod) | off (default locally)
GROQ_PARSE_MODEL=         # default openai/gpt-oss-120b
GROQ_CHAT_MODEL=          # default openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=      # default qwen/qwen3.8-27b (llama-3.3-70b-versatile is no longer on Groq)
CUBBIE_HANDLE= # Cubbie's iMessage phone number or email, for the one-tap Open in iMessage page (optional: without it the page offers Copy)
CUBBIE_PUBLIC_SIGNING_KEY= # public by design: ships inside the Cubbie Skill (openssl rand -hex 32); must differ from every other secret
FEED_ENCRYPTION_KEY=      # 32 random bytes, base64 (openssl rand -base64 32)
LOAD_AWARE_SPLIT=false    # true: nudge the split away from members with a busy calendar
GOOGLE_USER_CLIENT_ID=     # per-user Google free/busy (Web OAuth client, redirect PUBLIC_URL/api/google/callback); optional
GOOGLE_USER_CLIENT_SECRET=
