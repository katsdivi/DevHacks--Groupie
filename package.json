{
  "name": "groupie",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @groupie/server --filter @groupie/web dev",
    "build": "pnpm --filter @groupie/web build",
    "start": "pnpm --filter @groupie/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "google:auth": "pnpm --filter @groupie/server google:auth",
    "canvas:inspect": "scripts/inspect-imports.sh",
    "feed:inspect": "scripts/inspect-feed.sh",
    "demo:reset": "pnpm --filter @groupie/server exec tsx --env-file-if-exists=../../.env src/demo/cli.ts reset",
    "demo:seed": "pnpm --filter @groupie/server exec tsx --env-file-if-exists=../../.env src/demo/cli.ts seed",
    "demo:remind": "pnpm --filter @groupie/server exec tsx --env-file-if-exists=../../.env src/demo/cli.ts remind",
    "demo:warm": "pnpm --filter @groupie/server exec tsx --env-file-if-exists=../../.env src/demo/cli.ts warm"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
